{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "rewrites": [
    {
      "source": "/pt-br",
      "destination": "/"
    },
    {
      "source": "/pt-br/",
      "destination": "/"
    },
    {
      "source": "/pt-br/:path*",
      "destination": "/:path*"
    }
  ]
}
